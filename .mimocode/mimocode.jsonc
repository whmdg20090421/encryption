{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "permission": {
    // 只读操作全部自动放行
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    // 文件编辑自动放行
    "edit": "allow",
    // bash 命令：默认需确认，安全命令放行，危险命令拦截
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git show*": "allow",
      "git rev-list*": "allow",
      "git rev-parse*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "uname *": "allow",
      "readelf *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "type *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "diff *": "allow",
      "patchelf *": "allow",
      "source *": "allow",
      "pkg *": "ask",
      "apt *": "ask",
      "npm *": "ask",
      "pip *": "ask",
      "rm -rf *": "deny",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git checkout -- *": "ask"
    },
    // 子代理和任务自动放行
    "task": "allow",
    "actor": "allow",
    "external_directory": "ask"
  }
}
