<?xml version="1.0" encoding="utf-8"?>
<!--
    覆盖 Media3 默认控制条布局 exo_player_control_view。

    目标布局（单行，左→右）：
      [上一集 · 暂停/播放 · 下一集]  [进度条 weight=1]  [00:12 / 03:45]  [全屏等默认按钮]

    改动点：
    - 删除中央的「快退 5 秒 / 快进 5 秒」include。
    - 中央 exo_center_controls 清空（仅保留容器以兼容库的显隐动画）。
    - 底部 exo_bottom_bar 由 FrameLayout 改为一行的 LinearLayout，
      上一集/暂停播放/下一集 移到进度条左侧，进度条用 weight=1 尽量拉长。
    - 未指定的控件与行为（时间刷新、拖动 seek、无障碍、键盘事件等）沿用 Media3 默认。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 0dp 尺寸避免影响 wrap_content 父容器测量；实际尺寸在代码里展开为铺满父容器。 -->
  <!-- 背景改为透明：不再整屏压暗，只保留顶部栏/底部栏各自的半透明底。 -->
  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@android:color/transparent"/>

  <LinearLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
      android:layout_gravity="bottom"
      android:background="@color/exo_bottom_bar_background"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <!-- 上一集/下一集按钮已移除：本播放器不支持播放列表切换。
         Media3 对缺失的 exo_prev / exo_next 全程使用可空判断，删除不会崩溃。 -->

    <ImageButton android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:layout_width="@dimen/exo_play_pause_icon_size"
        android:layout_height="@dimen/exo_play_pause_icon_size"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:scaleType="fitCenter"/>

    <View android:id="@id/exo_progress_placeholder"
        android:layout_width="0dp"
        android:layout_height="@dimen/exo_styled_progress_layout_height"
        android:layout_weight="1"/>

    <LinearLayout android:id="@id/exo_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:importantForAccessibility="noHideDescendants">

      <TextView android:id="@id/exo_position"
          style="@style/ExoStyledControls.TimeText.Position"
          android:paddingLeft="2dp"
          android:paddingRight="0dp"/>

      <TextView
          style="@style/ExoStyledControls.TimeText.Separator"
          android:paddingLeft="1dp"
          android:paddingRight="1dp"
          android:text="/"/>

      <TextView android:id="@id/exo_duration"
          style="@style/ExoStyledControls.TimeText.Duration"
          android:paddingLeft="0dp"
          android:paddingRight="2dp"/>

    </LinearLayout>

    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_vr"
          style="@style/ExoStyledControls.Button.Bottom.VR"/>

      <ImageButton android:id="@id/exo_shuffle"
          style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

      <ImageButton android:id="@id/exo_subtitle"
          style="@style/ExoStyledControls.Button.Bottom.CC"/>

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

    </LinearLayout>

    <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible">

      <LinearLayout android:id="@id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layoutDirection="ltr">

        <ImageButton android:id="@id/exo_overflow_hide"
            style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

      </LinearLayout>

    </HorizontalScrollView>

  </LinearLayout>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!-- 中央区域：清空（按钮已移到底部行左侧）。保留容器以兼容库的显隐/淡入淡出动画。 -->
  <LinearLayout
      android:id="@id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:padding="@dimen/exo_styled_controls_padding"
      android:clipToPadding="false"
      android:layoutDirection="ltr"/>

  <!-- 顶部控制条：左侧返回按钮 + 居中视频名称。随控制条一起淡入淡出。 -->
  <LinearLayout
      android:id="@+id/exo_top_controls"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:layout_gravity="top"
      android:background="@color/exo_bottom_bar_background"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton
        android:id="@+id/video_back_button"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回"
        android:src="@drawable/ic_video_back"
        android:scaleType="centerInside"/>

    <TextView
        android:id="@+id/video_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/exo_white"
        android:textSize="16sp"/>

    <!-- 右侧自定义设置按钮（宽度与返回按钮一致，保证标题视觉居中）。点击行为待接入。 -->
    <ImageButton
        android:id="@+id/video_settings_button"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="设置"
        android:src="@drawable/ic_video_settings"
        android:scaleType="centerInside"/>

    <View
        android:id="@+id/exo_media_route_button_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

  </LinearLayout>

</merge>
